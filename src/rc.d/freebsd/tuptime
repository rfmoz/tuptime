#!/bin/sh
#
# PROVIDE: tuptime
# REQUIRE: DAEMON
# KEYWORD: nojail shutdown

. /etc/rc.subr

name="tuptime"
rcvar="tuptime_enable"
command="/usr/local/bin/tuptime"
tuptime_user="_tuptime"

start_cmd="${name}_start"
stop_cmd="${name}_stop"

tuptime_start()
{
	echo "Starting ${name}."
	su -m ${tuptime_user} -c "${command} -q" 2> /dev/null || ${command} -q 2> /dev/null
}

tuptime_stop()
{
	echo "Stopping ${name}."
	su -m ${tuptime_user} -c "${command} -qg" 2> /dev/null || ${command} -qg 2> /dev/null
}

load_rc_config "${name}"
: ${tuptime_enable:="NO"}
run_rc_command "$1"
