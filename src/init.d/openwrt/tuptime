#!/bin/sh /etc/rc.common

START=99
STOP=60

TUPTIME_BIN=/usr/bin
TUPTIME_DIR=/opt/tuptime

start() {
        [ -d $TUPTIME_DIR ] || mkdir -p $TUPTIME_DIR
        [ -e /var/lib/tuptime ] || ln -s $TUPTIME_DIR /var/lib/tuptime
        echo 'Tuptime start'
        $TUPTIME_BIN/python3 $TUPTIME_BIN/tuptime -q
}

stop() {
        echo 'Tuptime stop'
        $TUPTIME_BIN/python3 $TUPTIME_BIN/tuptime -qg
}
